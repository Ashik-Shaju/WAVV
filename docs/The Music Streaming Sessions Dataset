@charset "utf-8";

@font-face { font-family: "IBM Plex Sans"; font-weight: 400; font-style: normal; font-display: swap; src: url("../fonts/IBMPlexSans-Regular.woff2") format("woff2"); }

@font-face { font-family: "IBM Plex Sans"; font-weight: 500; font-style: normal; font-display: swap; src: url("../fonts/IBMPlexSans-Medium.woff2") format("woff2"); }

@font-face { font-family: "IBM Plex Sans"; font-weight: 600; font-style: normal; font-display: swap; src: url("../fonts/IBMPlexSans-SemiBold.woff2") format("woff2"); }

:root { --arxiv-open-blue: #a5d6fe; --arxiv-link-blue: #1565c0; --arxiv-link-hover: #1050a0; --arxiv-grey-dis: #b0aba6; --arxiv-grey: #6b6459; --arxiv-ink: #1c1a17; --arxiv-warm-wash: #f9f7f7; --arxiv-card-grey: #f0eeec; --arxiv-active-bg: #d6e8f7; --arxiv-pill-border: #e4e0db; --arxiv-border-light: #ddd8d2; --arxiv-focus-ring-dark: #64b5f6; --arxiv-font-sans: "IBM Plex Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }

.is-sr-only { width: 1px; height: 1px; padding: 0px; margin: -1px; overflow: hidden; clip: rect(0px, 0px, 0px, 0px); white-space: nowrap; border: 0px; position: absolute !important; }

.ds-site-footer { clear: both; border-top: 1px solid var(--arxiv-pill-border); background: var(--arxiv-warm-wash); padding: 24px 24px 28px; margin: 0px; font-family: var(--arxiv-font-sans); }

.ds-site-footer a, .ds-site-footer a:hover, .ds-site-footer a:active { border-bottom: 0px; }

.ds-site-footer-grid { display: flex; gap: 24px 32px; align-items: center; justify-content: space-between; flex-wrap: wrap; max-width: 1200px; margin: 0px auto; }

.ds-site-footer-main { flex: 1 1 320px; min-width: 280px; max-width: 720px; }

.ds-site-footer-ack { font-size: 0.875rem; color: var(--arxiv-ink); margin-bottom: 14px; line-height: 1.6; }

.ds-site-footer-ack a { font-size: 0.8125rem; color: var(--arxiv-ink); text-decoration: underline; }

.ds-site-footer-ack a:hover { text-decoration-style: dotted; }

.ds-site-footer-ack strong { color: var(--arxiv-ink); font-weight: 600; }

.ds-site-footer-links { display: flex; gap: 8px; flex-wrap: wrap; font-size: 0.8125rem; line-height: 1.8; }

.ds-site-footer-links a { font-size: 0.8125rem; color: var(--arxiv-link-hover); text-decoration: none; }

.ds-site-footer-links a:hover { color: var(--arxiv-ink); text-decoration: underline; }

.ds-site-footer-links a:focus-visible { outline: 2px solid var(--arxiv-link-hover); outline-offset: 2px; border-radius: 2px; }

.ds-site-footer-sep { color: var(--arxiv-grey); margin: 0px 4px; }

.ds-site-footer-funders { flex-shrink: 0; text-align: center; }

.ds-site-footer-funders-label { font-size: 0.875rem; font-weight: 600; color: var(--arxiv-ink); margin-bottom: 12px; line-height: 1.4; }

.ds-site-footer-funders-logos { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }

.ds-site-footer a.ds-funder-link { display: inline-flex; align-items: center; justify-content: center; padding: 4px 8px; border: 1px solid var(--arxiv-pill-border); border-radius: 3px; background: rgb(255, 255, 255); transition: border-color 0.15s; }

.ds-site-footer a.ds-funder-link:hover { border-color: var(--arxiv-link-blue); }

.ds-site-footer a.ds-funder-link:focus-visible { outline: 2px solid var(--arxiv-link-blue); outline-offset: 2px; }

.ds-funder-logo { display: block; height: 48px; width: auto; flex-shrink: 0; }

@media (max-width: 720px) {
  .ds-site-footer-funders { width: 100%; margin-top: 8px; }
  .ds-site-footer-funders-logos { gap: 10px; }
  .ds-site-footer a.ds-funder-link { width: 220px; max-width: 100%; padding: 10px 14px; }
  .ds-funder-logo { height: 44px; max-width: 100%; }
}

@media print {
  .ds-site-footer { display: none !important; }
}

.ds-skip-link { position: absolute; top: -100px; left: 8px; z-index: 200; background: var(--arxiv-ink); color: rgb(255, 255, 255); padding: 10px 16px; border-radius: 4px; text-decoration: none; font-family: var(--arxiv-font-sans); font-weight: 600; }

.ds-skip-link:focus-visible { top: 8px; outline: 3px solid var(--arxiv-focus-ring-dark, #64b5f6); outline-offset: 2px; }

.ds-announcement { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 8px 24px; background: var(--arxiv-open-blue); color: var(--arxiv-ink); font-family: var(--arxiv-font-sans); font-size: 0.8125rem; font-weight: 500; text-align: center; box-shadow: rgba(0, 0, 0, 0.1) 0px 2px 6px; position: relative; z-index: 101; }

.ds-announcement.is-dismissed { display: none; }

.ds-announcement-glyph { height: 20px; width: auto; flex-shrink: 0; }

.ds-announcement .ds-announcement-link { color: var(--arxiv-ink); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }

